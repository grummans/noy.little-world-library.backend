# Copy to .env for local runs. Never commit real values.
APP_ENV=dev
HTTP_ADDR=:8080

# PostgreSQL 16 on .48. App user in dev; separate credentials for prod later.
DATABASE_URL=postgres://postgres:PASSWORD@192.168.1.48:5432/little_world_dev?sslmode=disable

# MinIO. S3_ENDPOINT is what the API talks to; S3_PUBLIC_ENDPOINT is the host baked
# into presigned URLs (must be reachable by the browser, so it differs per env).
S3_ENDPOINT=http://192.168.1.48:9000
S3_PUBLIC_ENDPOINT=http://192.168.1.48:9000
S3_REGION=us-east-1
S3_BUCKET=little-world
S3_ACCESS_KEY=
S3_SECRET_KEY=

# VNPay sandbox. Leave empty to disable checkout (POST /api/orders returns 503).
# If any of the first three is set, all four are required or the API refuses to start.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/checkout/return
