# Copy to .env on the server, fill in the secrets there, then `chmod 600 .env`.
# Never commit this file and never copy a developer .env to the server.
# Compose reads it for ${...} interpolation and passes it to the containers.

# --- Images: update tags to deploy or roll back --------------------------------
API_IMAGE=ghcr.io/grummans/noy.little-world-library.backend:dev
WEB_IMAGE=ghcr.io/grummans/noy.little-world-library.frontend:dev
# --- host ports NPM points at ----------------------------------------------
API_PORT=8081
WEB_PORT=8082

# --- PostgreSQL 16 (internal only) -----------------------------------------
POSTGRES_USER=little_world
POSTGRES_DB=little_world_staging
POSTGRES_PASSWORD=
# --- Existing private MinIO on .48 ------------------------------------------
S3_ENDPOINT=http://192.168.1.48:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=little-world-staging
S3_PUBLIC_ENDPOINT=https://media-staging-littleworld.duckdns.org

# --- VNPay sandbox ----------------------------------------------------------
# Leave TMN_CODE and HASH_SECRET empty to deploy with checkout disabled (503).
# Setting only one of them makes the API refuse to start.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://staging-littleworld.duckdns.org/payment/return
